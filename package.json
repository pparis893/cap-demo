{
  "name": "cap-demo",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "build:mta": "mbt build -t mta_archives",
    "deploy": "cf deploy mta_archives/cap-demo_1.0.0.mtar",
    "undeploy": "cf undeploy cap-demo --delete-services --delete-service-keys"
  },
  "private": true,
  "cds": {
    "requires": {
      "[development]": {
        "auth": "dummy"
      },
      "[production]": {
        "db": "hana",
        "auth": "xsuaa"
      }
    }
  }
}
